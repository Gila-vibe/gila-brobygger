    <script>

        /* -----------------------------------------
           SERVICE DROPDOWN
           ----------------------------------------- */

        const servicesToggle =
            document.getElementById("servicesToggle");

        const servicesMenu =
            document.getElementById("servicesMenu");


        servicesToggle.addEventListener("click", function (event) {

            event.stopPropagation();

            const isOpen =
                servicesMenu.classList.toggle("show");

            servicesToggle.setAttribute(
                "aria-expanded",
                isOpen ? "true" : "false"
            );

        });


        /* -----------------------------------------
           CLOSE DROPDOWN WHEN CLICKING OUTSIDE
           ----------------------------------------- */

        document.addEventListener("click", function () {

            servicesMenu.classList.remove("show");

            servicesToggle.setAttribute(
                "aria-expanded",
                "false"
            );

        });


        /* -----------------------------------------
           DON'T CLOSE WHEN CLICKING INSIDE MENU
           ----------------------------------------- */

        servicesMenu.addEventListener("click", function (event) {

            event.stopPropagation();

        });

    </script>


